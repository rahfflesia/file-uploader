<div class="error-message">
  <div class="inner-error-message">
    <span class="error-count"></span>
    <div class="main-error-area">
      <div class="previous">&lt;</div>
      <div class="message"></div>
      <div class="next">&gt;</div>
    </div>
  </div>
</div>
<script defer>
  const e = <%- JSON.stringify(locals.errors ?? null) %>

  let index = 0;
  let timeoutId = 0;

  if(e && e.length > 0) {
    console.log(e);

    const errorMessageContainer = document.querySelector(".error-message");
    const previous = document.querySelector(".previous");
    const next = document.querySelector(".next");
    const errorMessageArea = document.querySelector(".message")
    const errorCountContainer = document.querySelector(".error-count");

    if(e.length > 1) {
      errorCountContainer.textContent = `Errors ${index + 1}/${e.length}`
      previous.addEventListener('click', () => {
        if(index <= 0) {
          console.log("Indice", index, "Reseteando...");
          index = e.length - 1;
        } else {
          index--;
        }
        errorMessageArea.textContent = e[index].msg;
        errorCountContainer.textContent = `Errors ${index + 1}/${e.length}`
        console.log(index);
      });

      next.addEventListener('click', () => {
        if(index >= e.length - 1) {
          index = 0;
        } else {
          index++;
        }
        errorMessageArea.textContent = e[index].msg;
        errorCountContainer.textContent = `Errors ${index + 1}/${e.length}`
      });
    } else {
      previous.style.display = 'none';
      next.style.display = 'none';
    }


    errorMessageContainer.classList.toggle('slide');
    errorMessageArea.textContent = e[index].msg;

    timeoutId = setTimeout(() => {
      errorMessageContainer.classList.toggle('slide');
    }, 5000);

    errorMessageContainer.addEventListener('mouseenter', () => {
      clearTimeout(timeoutId);
    });

    errorMessageContainer.addEventListener('mouseleave', () => {
      timeoutId = setTimeout(() => {
        errorMessageContainer.classList.toggle('slide')
      }, 3000);
    });
  }
</script>
