<dialog class="resource-details" style="min-width: 275px">
  <header class="flex-between-row" style="flex-wrap: nowrap; gap: 1rem">
    <h1 class="header-details"></h1>
    <div class="close-icon close-resource-details-dialog grid-center">
      <img
        src="https://img.icons8.com/?size=100&id=8112&format=png&color=000000"
        alt="close-icon"
      />
    </div>
  </header>
  <h3
    class="resource-name blue"
    style="min-width: 0; word-wrap: break-word"
  ></h3>
  <span class="file-extension-details" style="font-weight: 500;"></span>
  <span class="resource-size"></span>
  <span class="resource-upload-date"></span>
</dialog>
