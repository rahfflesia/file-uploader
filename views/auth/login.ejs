<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>FileUploader</title>
  </head>
  <body class="mh-100dvh flex-column">
    <%- include("../partials/errorToast") %>
    <div class="login-form-wrapper flex-column">
      <div class="app-name-wrapper">
        <h1 class="app-name"></h1>
      </div>
      <form action="/auth/log-in" method="post" class="login-form">
        <div class="form-section">
          <h1 style="text-align: center">Log in</h1>
          <span style="text-align: center" class="gray-text"
            >Please enter your details to log in</span
          >
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            name="username"
            class="default-input"
            required
            minlength="4"
            maxlength="320"
          />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            name="password"
            class="default-input"
            required
            minlength="5"
          />
        </div>
        <button type="submit" class="regular-button">Log in</button>
        <span class="gray-text" style="text-align: center"
          >Don't have an account yet? <a href="/auth/sign-up">Sign up</a></span
        >
      </form>
    </div>
  </body>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const appNameContainer = document.querySelector(".app-name");
      const text = "FileUploader";
      let animationDelayMs = 300;
      for (let i = 0; i < text.length; i++) {
        const currentLetter = text[i];
        const span = document.createElement("span");
        span.style.animation = `fall 500ms ${animationDelayMs}ms ease 1 forwards`;
        span.textContent = currentLetter;
        appNameContainer.appendChild(span);
        animationDelayMs += 50;
      }
    });
  </script>
</html>
