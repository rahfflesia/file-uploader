<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileUploader</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/dashboard/dashboard.css">
  </head>
  <body>
    <div class="error-message"></div>
    <dialog class="link-dialog">
      <div class="link-dialog-wrapper">
        <div class="flex-between-row">
          <h2></h2>
          <div class="close-link-dialog close-icon grid-center">
            <img src="https://img.icons8.com/?size=100&id=8112&format=png&color=000000" alt="close-icon">
          </div>
        </div>
        <a href="" class="folder-link" target="_blank"></a>
        <button class="regular-button" onclick="copyLinkToClipboard()">Copy link to clipboard</button>
      </div>
    </dialog>
    <%- include("./partials/createFolderModal") %>
    <dialog class="share-folder-dialog">
      <div class="flex-between-row">
        <h2>Share folder</h2>
        <div class="close-icon close-share-folder grid-center">
          <img src="https://img.icons8.com/?size=100&id=8112&format=png&color=000000" alt="close-icon">
        </div>
      </div>
      <form action="/folder/share" method="post" class="flex-column" style="gap: 1rem;">
        <div class="form-group">
          <label for="expiration_days">Select the amount of days you want to share the folder for</label>
          <select name="expiration_days" class="default-input">
            <option value="1">1 day</option>
            <option value="7">7 days</option>
            <option value="15">15 days</option>
            <option value="30">30 days</option>
          </select>
        </div>
        <input type="hidden" name="folder_id" class="folder-id-input">
        <button type="submit" class="regular-button">Share</button>
      </form>
    </dialog>
    <%- include("./partials/uploadFileModal") %>
    <%- include('./partials/header') %>
    <main class="std-padding dashboard">
      <div class="subheader flex-between-row sm-mb">
        <div style="display: flex; flex-direction: column; gap: .25rem;">
          <% const fullName = locals.currentUser.first_name + ' ' + locals.currentUser.last_name %>
          <h2><%= fullName %>'s uploads</h2>
          <span class="gray-text" style="font-size: .8rem;">Manage and organize your storage assets</span>
        </div>
        <div>
          <button class="create-folder-button regular-button">Create new folder</button>
          <button class="regular-button upload-file-button">Upload file</button>
        </div>
      </div>
      <div class="info-cards sm-mb">
        <div class="storage-used" style="gap: .25rem;">
          <div style="display: flex; gap: 1rem; align-items: center;">
            <div class="storage-icon-wrapper">
              <img src="https://img.icons8.com/?size=100&id=114538&format=png&color=1b71e1" alt="storage-icon">
            </div>
            <div class="flex-column" style="gap: .25rem;">
              <span class="gray-text" style="font-size: .8rem;">TOTAL STORAGE USED</span>
              <span style="font-weight: 500;"><%= usedStorage %></span>
            </div>
          </div>
        </div>
        <div class="number-of-folders flex-column" style="gap: .25rem;">
          <div style="display: flex; gap: 1rem; align-items: center;">
            <div class="number-of-folders-icon-wrapper">
              <img src="https://img.icons8.com/?size=100&id=FVQqbNWLzhcc&format=png&color=000000" alt="folder-icon">
            </div>
            <div class="flex-column" style="gap: .25rem">
              <span class="gray-text" style="font-size: .8rem;">TOTAL ITEMS</span>
              <span style="font-weight: 500;"><%= rootElements.length %> Items</span>
            </div>
          </div>
        </div>
      </div>
      <% if(rootElements.length > 0) { %>
          <div class="table">
            <div class="table-header">
              <div>Name</div>
              <div>Total size</div>
              <div>Actions</div>
            </div>
            <% rootElements.forEach((element) => { %>
              <div class="table-row">
                <div class="folder-wrapper">
                  <div class="folder-icon grid-center">
                    <% if(element.type === "folder") { %>
                      <img src="https://img.icons8.com/?size=100&id=82843&format=png&color=1b71e1" alt="folder-icon">
                    <% } else if(element.type === "file") { %>
                      <% if(element.mime_type.includes('image')) { %>
                        <img src="https://img.icons8.com/?size=100&id=yF8LPIFelJU7&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } else if (element.mime_type.includes('video')) { %>
                        <img src="https://img.icons8.com/?size=100&id=99cTBfGlewZU&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } else if (element.mime_type.includes('audio')) { %>
                        <img src="https://img.icons8.com/?size=100&id=101924&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } else if (element.mime_type === 'application/pdf') { %>
                        <img src="https://img.icons8.com/?size=100&id=59859&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } else { %>
                        <img src="https://img.icons8.com/?size=100&id=ENKyxGggqj1D&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } %>
                    <% } %>
                  </div>
                  <a href="<%= element.type === 'folder' ? `/folder/files/${element.folder_id}` : `/file/details/${element.file_id}` %>" class="folder-name"><%= element.type === "folder" ? element.folder_name : element.file_name %></a>
                </div>
                <span><%= element.size %></span>
                <span style="display: flex; gap: .5rem;">
                  <div class="share-button-wrapper" style="display: flex; gap: .25rem; align-items: center; justify-content: center;">
                    <img src="https://img.icons8.com/?size=100&id=98959&format=png&color=1b71e1" alt="share-icon" class="share-folder-icon">
                    <button class="share-folder-button" onclick="shareFolder(<%= element.type === 'folder' ? element.folder_id : element.file_id %>)">Share</button>
                  </div>
                  <% if(element.share_link !== null) { %>
                    <div style="display: flex; gap: .25rem; align-items: center; justify-content: center;">
                      <img src="https://img.icons8.com/?size=100&id=I7J76hq8WtC6&format=png&color=1b71e1" alt="link-icon" class="view-link-icon">
                      <button onclick="viewShareLink(<%= JSON.stringify(element) %>)" class="view-link-button">Link</button>
                    </div>
                  <% } %>
                  <div style="display: flex; gap: .25rem; align-items: center; justify-content: center;">
                    <img src="https://img.icons8.com/?size=100&id=59770&format=png&color=1b71e1" alt="edit-icon" class="edit-folder-icon">
                    <a href="<%= element.type === 'folder' ? `/folder/update/${element.folder_id}` : `/file/update/${element.file_id}` %>" class="blue">Edit</a>
                  </div>
                  <div style="display: flex; gap: .25rem; align-items: center; justify-content: center;">
                    <img src="https://img.icons8.com/?size=100&id=FgOBVsURv5ar&format=png&color=ff0000" alt="delete-folder-icon" class="delete-folder-icon">
                    <a href="<%= element.type === 'folder' ? `/folder/delete/${element.folder_id}` : `/file/update/${element.file_id}` %>" class="delete">Delete</a>
                  </div>
                </span>
              </div>
            <% }); %>
          </div>
      <% } else { %>
          <div>You have no created any folders yet</div>
      <% } %>
    </main>
    <script>
      const folderDialog = document.querySelector(".folder-dialog");
      const createFolderButton = document.querySelector(".create-folder-button");
      const closeIcon = document.querySelector(".close-icon");

      const shareFolderDialog = document.querySelector(".share-folder-dialog");
      const closeShareFolderDialogButton = document.querySelector(".close-share-folder");

      const linkDialog = document.querySelector(".link-dialog");
      const closeLinkDialogButton = document.querySelector(".close-link-dialog");

      const uploadFileButton = document.querySelector(".upload-file-button");
      const uploadFileModal = document.querySelector(".upload-file-dialog");

      closeLinkDialogButton.addEventListener('click', () => {
        linkDialog.close();
      });

      createFolderButton.addEventListener('click', () => {
        folderDialog.showModal();
      });

      closeIcon.addEventListener('click', () => {
        folderDialog.close();
      });

      closeShareFolderDialogButton.addEventListener('click', () => {
        shareFolderDialog.close();
      });

      uploadFileButton.addEventListener('click', () => {
        uploadFileModal.showModal();
      }); 

      async function copyLinkToClipboard() {
        try {
          const link = document.querySelector(".folder-link");
          await navigator.clipboard.writeText(link.textContent);
          linkDialog.close();
        }
        catch(error) {
          console.error(error.message);
        }
      }

      function viewShareLink(folder) {
        const linkDialog = document.querySelector(".link-dialog");
        const h2 = document.querySelector(".link-dialog h2");
        const linkAnchor = document.querySelector(".folder-link");
        h2.textContent = `Share ${folder.folder_name} with the following link`;
        linkAnchor.href = folder.share_link;
        linkAnchor.textContent = folder.share_link;
        linkDialog.showModal();
      }

      function shareFolder(folderId) {
        const folderIdInput = document.querySelector('.folder-id-input');
        shareFolderDialog.showModal();
        folderIdInput.value = folderId;
      }
    </script>
  </body>
</html>
