<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileUploader</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/dashboard/dashboard.css">
  </head>
  <body class="mh-100dvh flex-column">
    <dialog class="link-dialog" style="min-width: 275px;">
      <div class="link-dialog-wrapper">
        <div class="flex-between-row" style="flex-wrap: nowrap; gap: 1rem;">
          <h2></h2>
          <div class="close-link-dialog close-icon grid-center">
            <img src="https://img.icons8.com/?size=100&id=8112&format=png&color=000000" alt="close-icon">
          </div>
        </div>
        <a href="" class="folder-link" target="_blank"></a>
        <button class="regular-button" onclick="copyLinkToClipboard()">Copy link to clipboard</button>
      </div>
    </dialog>
    <%- include("./partials/createFolderModal") %>
    <%- include("./partials/errorToast") %>
    <%- include("./partials/successToast") %>
    <%- include("./partials/details") %>
    <dialog class="share-folder-dialog">
      <div class="flex-between-row">
        <h2>Share folder</h2>
        <div class="close-icon close-share-folder grid-center">
          <img src="https://img.icons8.com/?size=100&id=8112&format=png&color=000000" alt="close-icon">
        </div>
      </div>
      <form action="/folder/share" method="post" class="flex-column" style="gap: 1rem;">
        <div class="form-group">
          <label for="expiration_days">Select the amount of days you want to share the folder for</label>
          <select name="expiration_days" class="default-input">
            <option value="1">1 day</option>
            <option value="7">7 days</option>
            <option value="15">15 days</option>
            <option value="30">30 days</option>
          </select>
        </div>
        <input type="hidden" name="folder_id" class="folder-id-input">
        <button type="submit" class="regular-button">Share</button>
      </form>
    </dialog>
    <dialog class="share-file-dialog">
      <header class="flex-between-row">
        <h2>Share file</h2>
        <div class="close-icon close-share-file grid-center">
          <img src="https://img.icons8.com/?size=100&id=8112&format=png&color=000000" alt="close-icon">
        </div>
      </header>
      <form action="/file/share" method="post" class="flex-column" style="gap: 1rem;">
        <div class="form-group">
          <label for="expiration_days">Select the amount of days you want to share this file for</label>
          <select name="expiration_days" class="default-input">
            <option value="1">1 day</option>
            <option value="7">7 days</option>
            <option value="15">15 days</option>
            <option value="30">30 days</option>
          </select>
        </div>
        <input type="hidden" name="file_id" class="file-id-input">
        <button type="submit" class="regular-button">Share</button>
      </form>
    </dialog>
    <%- include("./partials/uploadFileModal") %>
    <%- include('./partials/header') %>
    <main class="std-padding dashboard flex-column flex-1">
      <div class="subheader flex-between-row sm-mb" style="gap: 1.5rem;">
        <div style="display: flex; flex-direction: column; gap: .25rem;">
          <% const fullName = locals.currentUser.first_name + ' ' + locals.currentUser.last_name %>
          <h2><%= fullName %>'s uploads</h2>
          <span class="gray-text" style="font-size: .8rem;">Manage and organize your storage assets</span>
        </div>
      </div>
      <div class="actions-buttons-subheader sm-mb">
          <button class="create-folder-button regular-button">Create new folder</button>
          <button class="regular-button upload-file-button">Upload file</button>
      </div>
      <div class="sm-mb">
        <h3>Path <span class="blue"><%= path %></span></h3>
      </div>
      <div class="info-cards sm-mb">
        <div class="storage-used" style="gap: .25rem;">
          <div style="display: flex; gap: 1rem; align-items: center;">
            <div class="storage-icon-wrapper">
              <img src="https://img.icons8.com/?size=100&id=114538&format=png&color=1b71e1" alt="storage-icon">
            </div>
            <div class="flex-column" style="gap: .25rem;">
              <span class="gray-text flex-1" style="font-size: .8rem; display: flex; justify-content: flex-start; align-items: center;">TOTAL STORAGE USED</span>
              <span class="flex-1" style="font-weight: 500; display: flex; justify-content: flex-start; align-items: center;"><%= usedStorage %></span>
            </div>
          </div>
        </div>
        <div class="number-of-folders flex-column" style="gap: .25rem;">
          <div style="display: flex; gap: 1rem; align-items: center;" class="flex-1">
            <div class="number-of-folders-icon-wrapper">
              <img src="https://img.icons8.com/?size=100&id=FVQqbNWLzhcc&format=png&color=000000" alt="folder-icon">
            </div>
            <div class="flex-column" style="gap: .25rem">
              <span class="gray-text" style="font-size: .8rem;">TOTAL ITEMS</span>
              <span style="font-weight: 500;"><%= totalItems %> Items</span>
            </div>
          </div>
        </div>
      </div>

      <div class="sm-mb">
        <form action="/dashboard" method="get" class="search-bar-form">
          <input type="text" name="q" placeholder="Search anything..." class="search-input">
          <button type="submit" class="regular-button">
            Search
          </button>
        </form>
      </div>

      <% if(elements.rootData.length > 0) { %>
          <%- include("./partials/table") %>
      <% } else { %>
          <% if(elements.source === "search") { %>
            <div class="flex-column flex-1 no-folders-wrapper">
              <div class="no-folders-img-wrapper">
                <img src="https://img.icons8.com/?size=100&id=jos3LB58rh8D&format=png&color=1b71e1" alt="no-results-icon">
              </div>
              <span>No results found</span>
            </div>
          <% } else { %>
            <div class="flex-column flex-1 no-folders-wrapper">
              <div class="no-folders-img-wrapper">
                <img src="https://img.icons8.com/?size=100&id=83172&format=png&color=1b71e1" alt="no-folders-icon">
              </div>
              <span>You have not created any folders yet</span>
            </div>
          <% } %>
      <% } %>
    </main>
    <script>
      const folderDialog = document.querySelector(".folder-dialog");
      const createFolderButton = document.querySelector(".create-folder-button");
      const closeFolderDialogButton = document.querySelector(".close-folder-dialog");

      const shareFileDialog = document.querySelector(".share-file-dialog");
      const closeShareFileDialogButton = document.querySelector(".close-share-file");

      const shareFolderDialog = document.querySelector(".share-folder-dialog");
      const closeShareFolderDialogButton = document.querySelector(".close-share-folder");

      const linkDialog = document.querySelector(".link-dialog");
      const closeLinkDialogButton = document.querySelector(".close-link-dialog");

      const uploadFileButton = document.querySelector(".upload-file-button");
      const uploadFileModal = document.querySelector(".upload-file-dialog");
      const closeUploadDialogButton = document.querySelector(".close-upload-file-dialog");

      const elementsArray = <%- JSON.stringify(elements.rootData) %>
      const downloadButtons = document.querySelectorAll(".download-file-button");

      closeLinkDialogButton.addEventListener('click', () => {
        linkDialog.close();
      });

      createFolderButton.addEventListener('click', () => {
        folderDialog.showModal();
      });

      closeFolderDialogButton.addEventListener('click', () => {
        folderDialog.close();
      });

      closeShareFolderDialogButton.addEventListener('click', () => {
        shareFolderDialog.close();
      });

      uploadFileButton.addEventListener('click', () => {
        uploadFileModal.showModal();
      });

      closeUploadDialogButton.addEventListener('click', () => {
        uploadFileModal.close();
      });

      closeShareFileDialogButton.addEventListener('click', () => {
        shareFileDialog.close();
      });

      const resourceDetailsDialog = document.querySelector(".resource-details");
      const closeResourceDetailsDialogButton = document.querySelector(".close-resource-details-dialog");

      closeResourceDetailsDialogButton.addEventListener("click", () => {
        resourceDetailsDialog.close();
      });

      function openResourceDetailsDialog(element) {
        console.log(element);
        const resourceName = document.querySelector(".resource-name");
        const headerDetails = document.querySelector(".header-details");
        const resourceSize = document.querySelector(".resource-size");
        const resourceUploadDate = document.querySelector(".resource-upload-date");

        const capitalizedType = element.type.charAt(0).toUpperCase() + element.type.slice(1);
        headerDetails.textContent = `${capitalizedType} details`;

        switch(element.type) {
          case "file":
            resourceName.textContent = "Name: " + element.file_name;
            resourceSize.textContent = "Size: " + element.size;

            const uploadDate = new Date(element.uploaded_at);
            resourceUploadDate.textContent = "Upload date: " + uploadDate.toLocaleString("es-MX");
            break;
          case "folder":
            resourceName.textContent = "Name: " + element.folder_name;
            resourceSize.textContent = element.size === "0 B" ? "This folder is empty" : "Size: " + element.size;

            const lastUploadDate = new Date(element.last_used);
            resourceUploadDate.textContent = "Last upload (or creation date if a file has never been uploaded): " + lastUploadDate.toLocaleString("es-MX");
            break;
          default:
            console.error("This type of resource is not supported");
        }

        resourceDetailsDialog.showModal();
      }

      function download(file) {
        fetch(file.url).then((response) => response.blob()).then((blob) => {
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = url;
            a.download = file.file_name;
            a.click();
            document.body.appendChild(a);
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          }).catch((error) => console.error(error));
      }

      async function copyLinkToClipboard() {
        try {
          const link = document.querySelector(".folder-link");
          await navigator.clipboard.writeText(link.textContent);
          linkDialog.close();
        }
        catch(error) {
          console.error(error.message);
        }
      }

      function viewShareLink(element) {
        const linkDialog = document.querySelector(".link-dialog");
        const h2 = document.querySelector(".link-dialog h2");
        const linkAnchor = document.querySelector(".folder-link");
        h2.textContent = `Share this ${element.type} with the following link`;
        linkAnchor.href = element.share_link;
        linkAnchor.textContent = element.share_link;
        linkDialog.showModal();
      }

      function shareFolder(folderId) {
        const folderIdInput = document.querySelector('.folder-id-input');
        shareFolderDialog.showModal();
        folderIdInput.value = folderId;
      }

      function shareFile(fileId) {
        const fileIdInput = document.querySelector('.file-id-input');
        shareFileDialog.showModal();
        fileIdInput.value = fileId;
      }

      function recurse(folder) {
        for(const file of folder.files) {
          download(file);
        }

        for(const child of folder.childs) {
          recurse(child);
        }
      }

      for(let i = 0; i < downloadButtons.length; i++) {
        const downloadButton = downloadButtons[i];
        downloadButton.addEventListener('click', () => {
          console.log("La descarga debería iniciar...");
          const element = elementsArray[i];
          switch(element.type) {
            case 'file':
              download(element);
              break;
            case 'folder':
              recurse(element);
              break;
            default:
              console.error("Invalid type");
          }
        });
      }

      window.addEventListener("resize", () => {
        if(window.innerWidth > 1200) {
          resourceDetailsDialog.close();
        }
      });
    </script>
  </body>
</html>
