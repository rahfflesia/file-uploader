<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folder files</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <div class="error-message"></div>
    <%- include("../partials/uploadFileModal") %>
    <%- include('../partials/header') %>
    <%- include("../partials/createFolderModal") %>
    <main class="std-padding dashboard">
      <div class="flex-between-row sm-mb">
        <h2><span class="blue"><%= folder.folder_name %></span> <span>content</span></h2>
        <div>
          <button class="regular-button create-folder-button">Create new folder</button>
          <button class="upload-file-button regular-button">Upload file</button>
        </div>
      </div>
      <% if(elements.length > 0) { %>
        <div class="table">
          <div class="table-header">
            <div>File name</div>
            <div>Size</div>
            <div>Upload date</div>
            <div>Actions</div>
          </div>
          <% elements.forEach((element) => { %>
              <div class="table-row">
                <div class="file-name-wrapper">
                  <div class="file-type-icon-wrapper folder-icon">
                    <% if(element.type === "file") { %>
                      <% if(element.mime_type.includes('image')) { %>
                        <img src="https://img.icons8.com/?size=100&id=yF8LPIFelJU7&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } else if (element.mime_type.includes('video')) { %>
                        <img src="https://img.icons8.com/?size=100&id=99cTBfGlewZU&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } else if (element.mime_type.includes('audio')) { %>
                        <img src="https://img.icons8.com/?size=100&id=101924&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } else if (element.mime_type === 'application/pdf') { %>
                        <img src="https://img.icons8.com/?size=100&id=59859&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } else { %>
                        <img src="https://img.icons8.com/?size=100&id=ENKyxGggqj1D&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                      <% } %>
                    <% } else if (element.type === "folder") { %>
                        <img src="https://img.icons8.com/?size=100&id=82843&format=png&color=1b71e1" alt="folder-icon">
                    <% } %>
                  </div>
                  <a href="<%= element.type === 'folder' ? `/folder/files/${element.folder_id}` : `/file/details/${element.file_id}` %>" class="folder-name"><%= element.type === "folder" ? element.folder_name : element.file_name %></a>
                </div>
                <div><%= element.size %></div>
                <div class="actions">
                  <div style="display: flex; gap: .25rem; justify-content: center; align-items: center;">
                    <img src="https://img.icons8.com/?size=100&id=83159&format=png&color=1b71e1" alt="download-button" class="download-icon">
                    <button class="download-file-button share-folder-button">Download</button>
                  </div>
                  <div style="display: flex; gap: .25rem; justify-content: center; align-items: center;">
                    <img src="https://img.icons8.com/?size=100&id=59770&format=png&color=1b71e1" alt="edit-icon" class="edit-file-icon">
                    <a href="<%= element.type === 'folder' ? `/folder/update/${element.folder_id}` : `/file/update/${element.file_id}` %>" class="blue">Edit</a>
                  </div>
                  <div style="display: flex; gap: .25rem; justify-content: center; align-items: center;">
                    <img src="https://img.icons8.com/?size=100&id=FgOBVsURv5ar&format=png&color=ff0000" alt="delete-folder-icon" class="delete-folder-icon">
                    <a href="<%= element.type === 'folder' ? `/folder/delete/${element.folder_id}` : `/file/update/${element.file_id}` %>" class="delete">Delete</a>
                  </div>
                </div>
              </div>
          <% }); %>
        </div>
      <% } else { %>
          <div>This folder has no files</div>
      <% } %>
    </main>
  </body>
  <script>
    const uploadFileDialog = document.querySelector(".upload-file-dialog");
    const uploadFileButton = document.querySelector(".upload-file-button");
    const closeDialogButton = document.querySelector(".close-icon");

    const filesArray = <%- JSON.stringify(elements) %>
    const downloadButtons = document.querySelectorAll(".download-file-button");

    const createFolderModal = document.querySelector(".folder-dialog");
    const createFolderButton = document.querySelector(".create-folder-button");

    uploadFileButton.addEventListener('click', () => {
      uploadFileDialog.showModal();
    });

    closeDialogButton.addEventListener('click', () => {
      uploadFileDialog.close();
    });

    createFolderButton.addEventListener('click', () => {
      createFolderModal.showModal();
    });

    for(let i = 0; i < downloadButtons.length; i++) {
      const downloadButton = downloadButtons[i];
      downloadButton.addEventListener('click', () => {
        const file = filesArray[i];

        switch(file.type) {
          case "file":
              fetch(file.url).then((response) => response.blob()).then((blob) => {
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = file.file_name;
                a.click();
                document.body.appendChild(a);
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
              }).catch((error) => console.error(error));
            break;
          case "folder":
            // to do
            break;
          default:
            console.error("Invalid type");
        }
      });
    }
  </script>
</html>
