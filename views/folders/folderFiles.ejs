<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folder files</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <div class="error-message"></div>
    <dialog class="upload-file-dialog">
      <div class="flex-between-row">
        <h2>Upload file</h2>
        <div class="close-icon">
          <img src="https://img.icons8.com/?size=100&id=8112&format=png&color=000000" alt="close-icon">
        </div>
      </div>
      <form action="/file/upload/" method="post" enctype="multipart/form-data" class="file-upload-form flex-column" style="gap: 1rem;">
        <div class="form-group">
          <label for="uploaded_file">Select the file you want to upload</label>
          <input type="file" name="archivo">
        </div>
        <input type="hidden" name="folder_id" value="<%= folder.folder_id %>">
        <button type="submit" class="regular-button">Upload</button>
      </form>
    </dialog>
    <%- include('../partials/header') %>
    <main class="std-padding dashboard">
      <div class="flex-between-row sm-mb">
        <h2><%= folder.folder_name %> files</h2>
        <button class="upload-file-button regular-button">Upload file</button>
      </div>
      <% if(files.length > 0) { %>
        <div class="table">
          <div class="table-header">
            <div>File name</div>
            <div>Size</div>
            <div>Upload date</div>
            <div>Actions</div>
          </div>
          <% files.forEach((file) => { %>
              <div class="table-row">
                <div class="file-name-wrapper">
                  <div class="file-type-icon-wrapper">
                    <% if(file.mime_type.includes('image')) { %>
                        <img src="https://img.icons8.com/?size=100&id=yF8LPIFelJU7&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                    <% } else if (file.mime_type.includes('video')) { %>
                        <img src="https://img.icons8.com/?size=100&id=99cTBfGlewZU&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                    <% } else if (file.mime_type.includes('audio')) { %>
                        <img src="https://img.icons8.com/?size=100&id=101924&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                    <% } else if (file.mime_type === 'application/pdf') { %>
                        <img src="https://img.icons8.com/?size=100&id=59859&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                    <% } else { %>
                        <img src="https://img.icons8.com/?size=100&id=ENKyxGggqj1D&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                    <% } %>
                  </div>
                  <a href="/file/details/<%= file.file_id %>"><%= file.file_name %></a>
                </div>
                <div><%= file.bytes %></div>
                <div><%= file.uploaded_at.toLocaleDateString() %></div>
                <div class="actions">
                  <div style="display: flex; gap: .25rem; justify-content: center; align-items: center;">
                    <img src="https://img.icons8.com/?size=100&id=83159&format=png&color=1b71e1" alt="download-button" class="download-icon">
                    <button class="download-file-button share-folder-button">Download</button>
                  </div>
                  <div style="display: flex; gap: .25rem; justify-content: center; align-items: center;">
                    <img src="https://img.icons8.com/?size=100&id=59770&format=png&color=1b71e1" alt="edit-icon" class="edit-file-icon">
                    <a href="/file/update/<%= file.file_id %>" class="blue">Edit</a>
                  </div>
                  <div style="display: flex; gap: .25rem; justify-content: center; align-items: center;">
                    <img src="https://img.icons8.com/?size=100&id=FgOBVsURv5ar&format=png&color=ff0000" alt="delete-folder-icon" class="delete-folder-icon">
                    <a href="/file/delete/<%= file.file_id %>" class="delete">Delete</a>
                  </div>
                </div>
              </div>
          <% }); %>
        </div>
      <% } else { %>
          <div>This folder has no files</div>
      <% } %>
    </main>
  </body>
  <script>
    const uploadFileDialog = document.querySelector(".upload-file-dialog");
    const uploadFileButton = document.querySelector(".upload-file-button");
    const closeDialogButton = document.querySelector(".close-icon");

    const filesArray = <%- JSON.stringify(files) %>
    const downloadButtons = document.querySelectorAll(".download-file-button");

    const error = <%- JSON.stringify(errorMessage) %>

    uploadFileButton.addEventListener('click', () => {
      uploadFileDialog.showModal();
    });

    closeDialogButton.addEventListener('click', () => {
      uploadFileDialog.close();
    });

    for(let i = 0; i < downloadButtons.length; i++) {
      const downloadButton = downloadButtons[i];
      downloadButton.addEventListener('click', () => {
        const file = filesArray[i];
        fetch(file.url).then((response) => response.blob()).then((blob) => {
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = url;
            a.download = file.file_name;
            a.click();
            document.body.appendChild(a);
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }).catch((error) => console.error(error));;
      });
    }

    if(error) {
      const errorMessageContainer = document.querySelector(".error-message");
      errorMessageContainer.textContent = error;
      errorMessageContainer.style.display = "block";
      setTimeout(() => {
        errorMessageContainer.style.display = 'none';
      }, 5000);
    }
  </script>
</html>
