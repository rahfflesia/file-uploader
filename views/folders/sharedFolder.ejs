<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileUploader | Shared resource</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="mh-100dvh flex-column">
    <%- include("../partials/header"); %>
    <%- include("../partials/details"); %>
    <%- include("../partials/errorToast"); %>
    <%- include("../partials/successToast"); %>
    <main class="std-padding dashboard flex-column flex-1">
      <% if(type === "folder") { %>
        <% if(elements.rootData.length > 0) { %>
          <h2 class="sm-mb"><%= owner %> shared this folder with you</h2>
          <div class="sm-mb"><h2><span class="blue"><%= folderName %>'s</span> content</h2></div>
          <div class="sm-mb">
            <a class="regular-button" href="/folder/shared/download/<%= uuid %>">Download folder</a>
          </div>
          <form action="/folder/share/<%= uuid %>" method="get" class="search-bar-form sm-mb">
            <input type="text" name="q" placeholder="Search anything..." class="search-input">
            <button type="submit" class="regular-button">Search</button>
          </form>
          <%- include("../partials/table") %>
        <% } else { %>
          <% if(source === "none") { %>
            <div class="flex-column flex-1 no-folders-wrapper">
              <div class="no-folders-img-wrapper">
                <img src="https://img.icons8.com/?size=100&id=83172&format=png&color=1b71e1" alt="no-folders-icon">
              </div>
              <span>This folder has no files</span>
            </div>
          <% } else { %>
            <h2 class="sm-mb"><%= owner %> shared this folder with you</h2>
            <div class="sm-mb"><h2><span class="blue"><%= folderName %>'s</span> content</h2></div>
            <form action="/folder/share/<%= uuid %>" method="get" class="search-bar-form sm-mb">
              <input type="text" name="q" placeholder="Search anything..." class="search-input">
              <button type="submit" class="regular-button">Search</button>
            </form>
            <div class="flex-column flex-1 no-folders-wrapper">
              <div class="no-folders-img-wrapper">
                <img src="https://img.icons8.com/?size=100&id=jos3LB58rh8D&format=png&color=1b71e1" alt="no-results-icon">
              </div>
              <span>No results found</span>
            </div>
          <% } %>
        <% } %>
      <% } else if (type === "file") { %>
        <div class="file-details-wrapper grid-center" style="flex: 1">
          <div>
            <h2 style="text-align: center;"><%= owner %> shared this file with you</h2>
            <div class="file-details">
              <div class="file-preview-wrapper sm-mb">
                <% if(elements.mime_type.includes('image')) { %>
                  <img src="<%= elements.url %>" alt="image-preview" />
                <% } else if (elements.mime_type.includes('video')) { %>
                  <video src="<%= elements.url %>" controls></video>
                <% } else if (elements.mime_type.includes('audio')) { %>
                  <div class="file-type-icon-wrapper" style="width: 250px; height: 250px; position: relative; overflow: hidden;">
                    <img src="https://img.icons8.com/?size=100&id=101924&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon" style="margin: 0 auto;">
                    <audio src="<%= elements.url %>"  style="position: absolute; bottom: 0; border-radius: 0 0 var(--border-radius) var(--border-radius);" controls></audio>
                  </div>
                <% } else if(elements.mime_type.includes('application/pdf')) { %>
                 <div class="file-type-icon-wrapper" style="width: 250px; height: 250px;">
                    <img src="https://img.icons8.com/?size=100&id=59859&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                </div>
                <% } else { %>
                  <div class="file-type-icon-wrapper" style="width: 250px; height: 250px;">
                    <img src="https://img.icons8.com/?size=100&id=ENKyxGggqj1D&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                  </div>
                <% } %>
              </div>
              <div class="file-details-info">
                <h2><%= elements.file_name %></h2>
                <h3><%= elements.size %></h3>
                <span>Upload date: <%= elements.uploaded_at.toLocaleString("es-MX") %></span>
                <a class="regular-button" style="text-align: center;" href="/file/shared/download/<%= uuid %>">
                  Download
                </a>
              </div>
            </div>
          </div>
      </div>
      <% } %>
    </main>
  </body>
  <script defer>
    const resourceDetailsDialog = document.querySelector(".resource-details");
    const closeResourceDetailsDialogButton = document.querySelector(".close-resource-details-dialog");

    closeResourceDetailsDialogButton.addEventListener("click", () => {
      resourceDetailsDialog.close();
    });

    function openResourceDetailsDialog(element) {
        const resourceName = document.querySelector(".resource-name");
        const headerDetails = document.querySelector(".header-details");
        const resourceSize = document.querySelector(".resource-size");
        const resourceUploadDate = document.querySelector(".resource-upload-date");
        const fileExtension = document.querySelector(".file-extension-details");

        const capitalizedType = element.type.charAt(0).toUpperCase() + element.type.slice(1);
        headerDetails.textContent = `${capitalizedType} details`;

        switch(element.type) {
          case "file":
            resourceName.textContent = "Name: " + element.file_name;
            resourceSize.textContent = "Size: " + element.size;

            if(element.file_extension) {
              fileExtension.textContent = `Type: ${element.file_extension}`;
            }

            const uploadDate = new Date(element.uploaded_at);
            resourceUploadDate.textContent = "Upload date: " + uploadDate.toLocaleString("es-MX");
            break;
          case "folder":
            resourceName.textContent = "Name: " + element.folder_name;
            resourceSize.textContent = element.size === "0 B" ? "This folder is empty" : "Size: " + element.size;

            const lastUploadDate = new Date(element.last_used);
            resourceUploadDate.textContent = "Last upload (or creation date if a file has never been uploaded): " + lastUploadDate.toLocaleString("es-MX");
            break;
          default:
            console.error("This type of resource is not supported");
            return;
        }

        resourceDetailsDialog.showModal();
      }
  </script>
</html>
