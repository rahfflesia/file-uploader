<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileUploader | Shared resource</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="mh-100dvh flex-column">
    <%- include("../partials/header"); %>
    <main class="std-padding flex-column" style="flex: 1">
      <% if(type === "folder") { %>
        <h2 class="sm-mb"><%= owner %> shared this folder with you</h2>
        <% if(elements.length > 0) { %>
          <%- include("../partials/table") %>
        <% } else { %>
          <div>This folder has no files</div>
        <% } %>
      <% } else if (type === "file") { %>
        <div class="file-details-wrapper grid-center" style="flex: 1">
          <div>
            <h2 style="text-align: center;"><%= owner %> shared this file with you</h2>
            <div class="file-details">
              <div class="file-preview-wrapper">
                <% if(elements.mime_type.includes('image')) { %>
                  <img src="<%= elements.url %>" alt="image-preview" />
                <% } else if (elements.mime_type.includes('video')) { %>
                  <video src="<%= elements.url %>" controls></video>
                <% } else if (elements.mime_type.includes('audio')) { %>
                  <div class="file-type-icon-wrapper" style="padding: 0; display: block;">
                    <img src="https://img.icons8.com/?size=100&id=101924&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon" style="margin: 0 auto;">
                    <audio src="<%= elements.url %>" controls></audio>
                  </div>
                <% } else if(elements.mime_type.includes('application/pdf')) { %>
                  <!-- Aquí no se muy bien que usaré -->
                  <embed src="<%= elements.url %>" type="application/pdf">
                <% } else { %>
                  <div class="file-type-icon-wrapper">
                    <img src="https://img.icons8.com/?size=100&id=ENKyxGggqj1D&format=png&color=1b71e1" alt="file-type-icon" class="file-type-icon">
                  </div>
                <% } %>
              </div>
              <div class="file-details-info">
                <h2><%= elements.file_name %></h2>
                <h3><%= elements.size %></h3>
                <span>Upload date: <%= elements.uploaded_at.toLocaleDateString() %></span>
                <button class="regular-button download-button-file-details">Download</button>
              </div>
            </div>
          </div>
      </div>
      <% } %>
    </main>
  </body>
