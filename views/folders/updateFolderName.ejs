<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileUploader</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="mh-100dvh flex-column">
    <%- include("../partials/header") %> <%- include("../partials/errorToast")
    %>
    <div class="login-form-wrapper flex-column">
      <form action="/folder/update/" method="post" class="login-form">
        <h2>Update folder</h2>
        <div class="form-group">
          <label for="folder_name">Folder name</label>
          <input
            type="text"
            name="folder_name"
            value="<%= folder.folder_name %>"
            class="default-input"
          />
        </div>
        <input type="hidden" name="folder_id" value="<%= folder.folder_id %>" />
        <button type="submit" class="regular-button">Update</button>
      </form>
    </div>
  </body>
</html>
