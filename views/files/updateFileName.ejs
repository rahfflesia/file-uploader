<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FileUploader</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="mh-100dvh flex-column">
    <%- include('../partials/header') %>
    <%- include('..partials/errorToast') %>
    <div class="login-form-wrapper flex-column">
      <form action="/file/update" method="post" class="login-form">
        <h2>Update file name</h2>
        <div class="form-group">
          <label for="file_name">New name</label>
          <input
            type="text"
            name="file_name"
            value="<%= file.file_name %>"
            class="default-input"
          />
        </div>
        <input type="hidden" name="file_id" value="<%= file.file_id %>" />
        <button type="submit" class="regular-button">Update</button>
      </form>
    </div>
  </body>
</html>
